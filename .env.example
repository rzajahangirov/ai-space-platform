# Local: PGlite persists PostgreSQL data in .data/agentspace.
# Production / Docker: set DATABASE_URL to a PostgreSQL connection string.
DATABASE_URL=
PGLITE_PATH=.data/agentspace
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Seed is explicit: npm run db:seed. Change this before seeding a shared installation.
DEMO_PASSWORD=ShopSphere-local-2026!
# Real model calls require an administrator to configure an agent in the UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Optional OIDC. Callback: APP_ORIGIN/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Per-million-token prices, explicitly configured; missing prices are shown as unknown.
MODEL_PRICES_JSON={}
# Maximum estimated input + reserved output tokens per review (all agents combined).
AGENT_TOKEN_BUDGET=24000
# Default model for new agents when OPENAI_API_KEY is set (change per agent in the UI).
OPENAI_MODEL=gpt-5.5
# Hard cap on provider-reported tokens per agent run (all agents and tool steps combined).
AGENT_RUN_TOKEN_LIMIT=250000
# Automatic agent review after structural architecture edits (on/off), at most every 2 minutes.
LIVE_REVIEW=on
# Optional Redis cache for agent model responses (identical requests reuse the answer).
REDIS_URL=
# Cache lifetime in seconds (900 = 15 minutes).
AGENT_CACHE_TTL_SECONDS=900
# Agent council (ChatGPT + Gemini in isolated sandbox rooms). Limits apply from the moment the rooms are locked.
COUNCIL_TIME_LIMIT_SECONDS=400
COUNCIL_TOKEN_LIMIT=64000
COUNCIL_OPENAI_MODEL=
COUNCIL_GOOGLE_MODEL=gemini-flash-latest
# LangSmith monitoring for council sessions and agent model calls (optional).
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentspace
